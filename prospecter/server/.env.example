# Copie para .env e preencha. Todas as variáveis são opcionais.

# Porta e endereço do servidor. Por padrão só escuta na própria máquina.
PORTA=3737
HOST=127.0.0.1

# Token que a extensão envia no cabeçalho Authorization. Vazio = sem autenticação
# (aceitável enquanto o servidor só escuta em 127.0.0.1).
API_TOKEN=

# Arquivo do banco SQLite.
DB_CAMINHO=./dados/prospecter.db

# Groq: sem chave, o enriquecimento roda só com a pontuação heurística.
GROQ_API_KEY=
# Modelos disponíveis: https://console.groq.com/docs/models (o llama-3.3-70b-versatile
# do apex original não é mais oferecido). Plano gratuito: ~1.000 req/dia e 8.000 tokens/min.
GROQ_MODELO=openai/gpt-oss-120b
# Leads por chamada à Groq.
GROQ_LOTE=8

# O que você vende — a IA pontua e escreve a abordagem com base nisso.
OFERTA=criação de sites profissionais, sistemas sob medida e software (SaaS) para pequenos negócios

# Quantos leads o crawler processa em paralelo.
CONCORRENCIA=3
# Intervalo mínimo entre requisições ao Instagram (ms). Muito baixo = bloqueio.
INSTAGRAM_INTERVALO_MS=5000
# Leads coletados de novo depois desse prazo são reenriquecidos.
REENRIQUECER_DIAS=30
