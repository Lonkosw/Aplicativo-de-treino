{
  "expo": {
    "name": "Treino",
    "slug": "treino",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "treino",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "icon": "./assets/icone.png",
    "android": {
      "package": "com.lonkosw.treino",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/icone-adaptativo.png",
        "monochromeImage": "./assets/icone-monocromatico.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#E11D2B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4302ce4f-80ee-4a5d-9921-f4c147d7b08e"
      }
    }
  }
}
